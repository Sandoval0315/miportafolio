---
const studies = [
  {
    institution: "Instituto Técnico Ricaldone",
    degree: "Bachillerato Técnico en Desarrollo de Software",
    status: "Graduado",
    logo: "/images/education/ricaldone.png",
    logoClass: "ricaldone-logo",
    url: "https://www.ricaldone.edu.sv/index.php",
  },
  {
    institution: "Universidad Don Bosco",
    degree: "Técnico en Ingeniería en Ciencias de la Computación",
    status: "En curso",
    logo: "/images/education/udb.svg",
    logoClass: "udb-logo",
    url: "https://www.udb.edu.sv/udb/index.php",
  },
];
---

<section id="formacion" class="education" aria-labelledby="education-title">
  <div class="education-container">
    <header>
      <p class="eyebrow">Aprendizaje y crecimiento</p>
      <h2 id="education-title">Formación académica</h2>
    </header>
    <div class="education-grid">
      {studies.map((study) => (
        <article class="education-card">
          <div class="card-top">
            <a class:list={["institution-logo", study.logoClass]} href={study.url} target="_blank" rel="noopener noreferrer" aria-label={`Sitio oficial de ${study.institution}`}>
              <img src={study.logo} alt={`Logo de ${study.institution}`} width="160" height="60" loading="lazy" decoding="async" />
            </a>
            <span class:list={["study-status", { current: study.status === "En curso" }]}>
              <span aria-hidden="true">{study.status === "En curso" ? "●" : "✓"}</span>
              {study.status}
            </span>
          </div>
          <h3>{study.degree}</h3>
          <p class="institution-name">{study.institution}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .education {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: #fafafa;
    color: #171717;
    font-family: 'Lexend', sans-serif;
  }
  .education-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 3rem);
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: #666;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .education-card {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid #e3e3e3;
    border-radius: 20px;
    background: #fff;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .institution-logo {
    width: 160px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    border-radius: 10px;
  }
  .institution-logo img { width: 100%; height: 100%; object-fit: contain; }
  .institution-logo:focus-visible { outline: 2px solid #1b448b; outline-offset: 4px; }
  .ricaldone-logo { background: #20252b; }
  .udb-logo { background: #202f4a; }
  .study-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    color: #444;
    background: #f1f1f1;
    white-space: nowrap;
  }
  .current { color: #176044; background: #edf7f0; }
  .current span { font-size: 0.5rem; }
  h3 { font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.55; font-weight: 600; }
  .institution-name { margin-top: 0.75rem; font-size: 0.85rem; line-height: 1.6; color: #666; }
  @media (max-width: 640px) {
    .education-grid { grid-template-columns: minmax(0, 1fr); }
    .institution-logo { width: 144px; height: 56px; }
    .card-top { gap: 0.5rem; }
  }
</style>
